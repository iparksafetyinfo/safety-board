{
  "rules": {
    "field": {
      "$code": {

        "members": {
          ".read":  "auth != null",
          "$uid": {
            ".write": "auth != null && (root.child('field').child($code).child('members').child(auth.uid).child('rank').val() === 'own' || root.child('field').child($code).child('members').child(auth.uid).val() === 'own' || (!root.child('field').child($code).child('members').exists() && $uid === auth.uid))",
            ".validate": "(newData.isString() && newData.val().matches(/^(own|edit|view)$/)) || newData.hasChild('rank')",
            "rank":   { ".validate": "newData.isString() && newData.val().matches(/^(own|edit|view)$/)" },
            "vendor": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "name":   { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$o":     { ".validate": false }
          }
        },

        "entries": {
          ".read": "auth != null && root.child('field').child($code).child('members').child(auth.uid).exists()",
          ".indexOn": ["date"],

          "$id": {
            ".write": "auth != null && (root.child('field').child($code).child('members').child(auth.uid).val() === 'own' || root.child('field').child($code).child('members').child(auth.uid).child('rank').val() === 'own' || ((root.child('field').child($code).child('members').child(auth.uid).val() === 'edit' || root.child('field').child($code).child('members').child(auth.uid).child('rank').val() === 'edit') && (!data.exists() || data.child('by').val() === auth.uid)))",

            ".validate": "newData.hasChildren(['date','task','grade','phase','by'])",

            "date":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "start":  { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
            "end":    { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{2}:[0-9]{2}$/)" },
            "task":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "grade":  { ".validate": "newData.isString() && newData.val().length <= 8" },
            "phase":  { ".validate": "newData.isString() && newData.val().length <= 16" },
            "crew":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
            "by":     { ".validate": "newData.val() === auth.uid || newData.val() === data.val()" },
            "at":     { ".validate": "newData.isNumber()" },
            "zones":  { "$i": { ".validate": "newData.isString()" } },
            "levels": { "$i": { ".validate": "newData.isString()" } },
            "checks": { "$k": { ".validate": "newData.isBoolean()" } },
            "$rest":  { ".validate": "newData.isString() || newData.isNumber() || newData.isBoolean()" }
          }
        },

        "reviews": {
          ".read":  "auth != null && root.child('field').child($code).child('members').child(auth.uid).exists()",
          "$id": {
            ".write": "root.child('field').child($code).child('members').child(auth.uid).child('rank').val() === 'own' || root.child('field').child($code).child('members').child(auth.uid).val() === 'own'",
            "state": { ".validate": "newData.isString() && newData.val().matches(/^(ok|no)$/)" },
            "note":  { ".validate": "newData.isString() && newData.val().length <= 300" },
            "at":    { ".validate": "newData.isNumber()" },
            "by":    { ".validate": "newData.val() === auth.uid" },
            "$o":    { ".validate": false }
          }
        },

        "fit": {
          ".read":  "auth != null && root.child('field').child($code).child('members').child(auth.uid).exists()",
          ".write": "root.child('field').child($code).child('members').child(auth.uid).child('rank').val() === 'own' || root.child('field').child($code).child('members').child(auth.uid).val() === 'own'",
          "dx": { ".validate": "newData.isNumber() && newData.val() >= -2 && newData.val() <= 2" },
          "dy": { ".validate": "newData.isNumber() && newData.val() >= -2 && newData.val() <= 2" },
          "k":  { ".validate": "newData.isNumber() && newData.val() >= 0.1 && newData.val() <= 5" },
          "r":  { ".validate": "newData.isNumber() && newData.val() >= -360 && newData.val() <= 360" },
          "$o": { ".validate": false }
        },

        "points": {
          ".read":  "auth != null && root.child('field').child($code).child('members').child(auth.uid).exists()",
          ".write": "root.child('field').child($code).child('members').child(auth.uid).val() === 'own' || root.child('field').child($code).child('members').child(auth.uid).child('rank').val() === 'own'",
          "$layer": {
            "$zone": {
              "x":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
              "y":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
              "$o": { ".validate": false }
            }
          }
        },

        "$rest": { ".read": false, ".write": false }
      }
    },

    "$rest": { ".read": false, ".write": false }
  }
}
